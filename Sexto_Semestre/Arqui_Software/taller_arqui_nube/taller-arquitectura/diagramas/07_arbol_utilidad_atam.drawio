<mxfile host="generar_diagramas.py"><diagram name="07 · Árbol de Utilidad ATAM de EventFlow (Importancia, Dificultad)" id="07_arbol_utilidad_atam"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="962" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Utilidad&lt;/b&gt;&lt;br&gt;EventFlow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;arcSize=8;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="426.0" width="130" height="80" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;📈 Escalabilidad&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="195" y="111.0" width="175" height="52" as="geometry"/></mxCell><mxCell id="c3" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;rounded=1;html=1;endArrow=none;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c4" value="Picos de venta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="410" y="80" width="190" height="42" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;rounded=1;html=1;endArrow=none;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value="&lt;b&gt;(A,A)&lt;/b&gt; 10.000 usuarios llegan en 1 min al abrir la venta de un concierto → el sistema escala Pedidos y Pagos automáticamente y atiende con tasa de error &amp;lt; 1 %." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#cc0000;fontSize=12;arcSize=8;align=left;spacingLeft=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="640" y="73" width="640" height="58" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;rounded=1;html=1;endArrow=none;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="Crecimiento de demanda" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="410" y="152" width="190" height="42" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;rounded=1;html=1;endArrow=none;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c2" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="&lt;b&gt;(A,M)&lt;/b&gt; Pasar de 1.000 a 100.000 usuarios concurrentes (festival) añadiendo réplicas detrás del balanceador, sin cambiar código." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;arcSize=8;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="640" y="145" width="640" height="58" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;rounded=1;html=1;endArrow=none;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="&lt;b&gt;⚡ Rendimiento&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="195" y="255.0" width="175" height="52" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;rounded=1;html=1;endArrow=none;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c1" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="Latencia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="410" y="224" width="190" height="42" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;rounded=1;html=1;endArrow=none;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="&lt;b&gt;(A,A)&lt;/b&gt; La consulta de disponibilidad responde con p95 ≤ 200 ms con 10.000 usuarios concurrentes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#cc0000;fontSize=12;arcSize=8;align=left;spacingLeft=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="640" y="217" width="640" height="58" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;rounded=1;html=1;endArrow=none;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="Concurrencia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="410" y="296" width="190" height="42" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;rounded=1;html=1;endArrow=none;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c12" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="&lt;b&gt;(A,A)&lt;/b&gt; Dos usuarios compran el último asiento F-12 a la vez → solo uno lo obtiene, cero sobreventa, respuesta &amp;lt; 2 s." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#cc0000;fontSize=12;arcSize=8;align=left;spacingLeft=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="640" y="289" width="640" height="58" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;rounded=1;html=1;endArrow=none;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c18" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="&lt;b&gt;🟢 Disponibilidad&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="195" y="363.0" width="175" height="52" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;rounded=1;html=1;endArrow=none;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c1" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="Tolerancia a fallos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="410" y="368" width="190" height="42" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;rounded=1;html=1;endArrow=none;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c22" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="&lt;b&gt;(A,M)&lt;/b&gt; Cae una instancia de Pedidos → el balanceador la retira en &amp;lt; 5 s; disponibilidad mensual ≥ 99,99 %." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;arcSize=8;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="640" y="361" width="640" height="58" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;rounded=1;html=1;endArrow=none;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c24" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="&lt;b&gt;🔒 Seguridad&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="195" y="507.0" width="175" height="52" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;rounded=1;html=1;endArrow=none;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c1" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="Confidencialidad de pagos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="410" y="440" width="190" height="42" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;rounded=1;html=1;endArrow=none;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c28" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="&lt;b&gt;(A,M)&lt;/b&gt; Ningún número de tarjeta se almacena (tokenización PCI DSS); 0 incidentes de exposición." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;arcSize=8;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="640" y="433" width="640" height="58" as="geometry"/></mxCell><mxCell id="c33" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;rounded=1;html=1;endArrow=none;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c30" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="Integridad de entradas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="410" y="512" width="190" height="42" as="geometry"/></mxCell><mxCell id="c35" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;rounded=1;html=1;endArrow=none;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c28" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="&lt;b&gt;(A,M)&lt;/b&gt; Un QR duplicado o alterado se rechaza en el 100 % de los accesos al evento." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;arcSize=8;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="640" y="505" width="640" height="58" as="geometry"/></mxCell><mxCell id="c37" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;rounded=1;html=1;endArrow=none;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c34" target="c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="Autorización (RBAC)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="410" y="584" width="190" height="42" as="geometry"/></mxCell><mxCell id="c39" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;rounded=1;html=1;endArrow=none;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c28" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="&lt;b&gt;(M,B)&lt;/b&gt; Un organizador que pide ventas de un evento ajeno recibe 403 en el 100 % de los casos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;arcSize=8;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="640" y="577" width="640" height="58" as="geometry"/></mxCell><mxCell id="c41" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;rounded=1;html=1;endArrow=none;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c38" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="&lt;b&gt;🛠 Mantenibilidad&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="195" y="687.0" width="175" height="52" as="geometry"/></mxCell><mxCell id="c43" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;rounded=1;html=1;endArrow=none;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c1" target="c42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c44" value="Modificabilidad de pasarela" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="410" y="656" width="190" height="42" as="geometry"/></mxCell><mxCell id="c45" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;rounded=1;html=1;endArrow=none;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c42" target="c44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c46" value="&lt;b&gt;(M,M)&lt;/b&gt; Cambiar Stripe → PayU en ≤ 5 días-persona tocando solo el adaptador de Pagos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;arcSize=8;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="640" y="649" width="640" height="58" as="geometry"/></mxCell><mxCell id="c47" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;rounded=1;html=1;endArrow=none;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c44" target="c46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c48" value="Cambio de bus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="410" y="728" width="190" height="42" as="geometry"/></mxCell><mxCell id="c49" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;rounded=1;html=1;endArrow=none;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c42" target="c48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c50" value="&lt;b&gt;(M,M)&lt;/b&gt; Migrar Kafka → RabbitMQ afectando solo a los servicios que publican/se suscriben." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;arcSize=8;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="640" y="721" width="640" height="58" as="geometry"/></mxCell><mxCell id="c51" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;rounded=1;html=1;endArrow=none;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c48" target="c50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c52" value="&lt;b&gt;🙂 Usabilidad&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="195" y="795.0" width="175" height="52" as="geometry"/></mxCell><mxCell id="c53" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;rounded=1;html=1;endArrow=none;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c1" target="c52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c54" value="Eficiencia del promotor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="410" y="800" width="190" height="42" as="geometry"/></mxCell><mxCell id="c55" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;rounded=1;html=1;endArrow=none;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c52" target="c54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c56" value="&lt;b&gt;(M,B)&lt;/b&gt; Un promotor carga 50 eventos con una plantilla CSV en &amp;lt; 10 min." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;arcSize=8;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="640" y="793" width="640" height="58" as="geometry"/></mxCell><mxCell id="c57" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;rounded=1;html=1;endArrow=none;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c54" target="c56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c58" value="(Importancia para el negocio, Dificultad técnica): A = Alta · M = Media · B = Baja. En rojo los escenarios (A,A): son los que guían la arquitectura y se analizan primero en el ATAM." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="20" y="872" width="1260" height="40" as="geometry"/></mxCell><mxCell id="c59" value="07 · Árbol de Utilidad ATAM de EventFlow (Importancia, Dificultad)" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1300" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>