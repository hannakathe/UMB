<mxfile host="generar_diagramas.py"><diagram name="08 · Arquitectura ACTUAL del SUMP — el “Frankenstein” (punto de sensibilidad y riesgo en rojo)" id="08_sump_actual"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="👥&lt;br&gt;&lt;b&gt;20.000 estudiantes&lt;/b&gt;&lt;br&gt;lunes 8:00 a.m." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="140" height="90" as="geometry"/></mxCell><mxCell id="c2" value="🏢 Data center On-Premise (servidor físico anticuado)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=3;" vertex="1" parent="1"><mxGeometry x="190" y="60" width="640" height="560" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Monolito Java 8 · Spring MVC&lt;/b&gt; (registro de asignaturas)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=8;verticalAlign=top;arcSize=3;" vertex="1" parent="1"><mxGeometry x="220" y="105" width="580" height="235" as="geometry"/></mxCell><mxCell id="c4" value="Vistas web (JSP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="240" y="150" width="160" height="60" as="geometry"/></mxCell><mxCell id="c5" value="Controlador&lt;br&gt;Inscripciones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="420" y="150" width="160" height="60" as="geometry"/></mxCell><mxCell id="c6" value="Controlador&lt;br&gt;&lt;b&gt;PaymentGateway&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#cc0000;fontSize=12;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="600" y="150" width="180" height="60" as="geometry"/></mxCell><mxCell id="c7" value="Pool de hilos (p. ej. 200)&lt;br&gt;&lt;b&gt;hilos bloqueados esperando indefinidamente&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#cc0000;fontSize=12;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="600" y="240" width="180" height="80" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Oracle centralizada&lt;/b&gt;&lt;br&gt;bloqueos ACID estrictos" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="410" width="220" height="130" as="geometry"/></mxCell><mxCell id="c9" value="⚖ &lt;b&gt;Punto de trade-off&lt;/b&gt;: validación de 5 pasos + bloqueo ACID (Seguridad/Consistencia) vs. respuesta ≤ 2 s para 20.000 usuarios (Rendimiento/Disponibilidad)." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;shadow=1;align=left;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="400" width="195" height="190" as="geometry"/></mxCell><mxCell id="c10" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;entryX=0;entryY=0.5;" edge="1" parent="1" source="c1" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="JDBC (SQL directo)" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.55;entryY=0;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="☁ AWS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=3;fillColor=#fffaf3;" vertex="1" parent="1"><mxGeometry x="980" y="60" width="430" height="330" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Microservicio “Módulo de Pagos”&lt;/b&gt;&lt;br&gt;Node.js (creado por un practicante)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1010" y="110" width="370" height="80" as="geometry"/></mxCell><mxCell id="c16" value="BD de pagos" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="250" width="150" height="100" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="💳 &lt;b&gt;Pasarela de pagos actual&lt;/b&gt;&lt;br&gt;(proveedor externo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1010" y="460" width="370" height="70" as="geometry"/></mxCell><mxCell id="c19" value="API del proveedor" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.15;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="1" source="c15" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="HTTP REST SÍNCRONO&lt;br&gt;vía VPN inestable&lt;br&gt;(sin timeout)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#cc0000;strokeWidth=4;dashed=1;fontColor=#cc0000;fontStyle=1;" edge="1" parent="1" source="c6" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="🔴 &lt;b&gt;Punto de sensibilidad&lt;/b&gt;&lt;br&gt;La llamada REST síncrona Java → Node por la VPN. El tiempo de respuesta de &lt;i&gt;cada&lt;/i&gt; inscripción queda atado a la latencia de la VPN y de AWS: si AWS tarda 3 s, la inscripción tarda ≥ 3 s." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#cc0000;fontSize=12;shadow=1;align=left;spacingLeft=6;spacingRight=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="190" y="650" width="600" height="140" as="geometry"/></mxCell><mxCell id="c22" value="🔴 &lt;b&gt;Riesgo crítico&lt;/b&gt;&lt;br&gt;Sin timeout ni circuit breaker, cada fallo de la VPN deja un hilo bloqueado. Con 20.000 estudiantes el pool se agota en segundos → &lt;b&gt;colapso total&lt;/b&gt; a las 8:00 a.m. Además, no hay transacción entre Oracle y la BD de pagos → &lt;b&gt;pagos perdidos / transacciones huérfanas&lt;/b&gt;." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#cc0000;fontSize=12;shadow=1;align=left;spacingLeft=6;spacingRight=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="820" y="650" width="590" height="140" as="geometry"/></mxCell><mxCell id="c23" value="08 · Arquitectura ACTUAL del SUMP — el “Frankenstein” (punto de sensibilidad y riesgo en rojo)" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1440" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>