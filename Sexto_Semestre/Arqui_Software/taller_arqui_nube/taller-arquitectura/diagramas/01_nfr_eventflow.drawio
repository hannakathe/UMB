<mxfile host="generar_diagramas.py"><diagram name="01 · Lluvia de ideas de NFR de EventFlow por atributo de calidad" id="01_nfr_eventflow"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1380" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;EventFlow&lt;/b&gt;&lt;br&gt;Requisitos No Funcionales (NFR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;arcSize=8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="550" y="55" width="240" height="60" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;📈 Escalabilidad&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="165" width="200" height="50" as="geometry"/></mxCell><mxCell id="c3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c4" value="El sistema debe manejar &lt;b&gt;10.000 usuarios en 1 minuto&lt;/b&gt; cuando salen a la venta las entradas de un gran concierto." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;shadow=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="200" height="110" as="geometry"/></mxCell><mxCell id="c5" value="Pasar de 1.000 a &lt;b&gt;100.000 usuarios concurrentes&lt;/b&gt; (festival) añadiendo réplicas, sin cambiar código." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;shadow=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="365" width="200" height="110" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;🔒 Seguridad&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="240" y="165" width="200" height="50" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;" edge="1" parent="1" source="c1" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="Los datos de pago deben ser &lt;b&gt;100 % seguros&lt;/b&gt;: tokenización (PCI DSS), TLS 1.3, nunca guardar el número de tarjeta." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;shadow=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="240" y="240" width="200" height="110" as="geometry"/></mxCell><mxCell id="c9" value="RBAC: un organizador solo ve las ventas de &lt;b&gt;sus&lt;/b&gt; eventos; el administrador ve todos." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;shadow=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="240" y="365" width="200" height="110" as="geometry"/></mxCell><mxCell id="c10" value="Cada entrada lleva un &lt;b&gt;QR firmado&lt;/b&gt; de un solo uso: no se puede falsificar ni revender el mismo ID." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;shadow=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="240" y="490" width="200" height="110" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;⚡ Rendimiento&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="460" y="165" width="200" height="50" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;" edge="1" parent="1" source="c1" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="Consulta de disponibilidad de asientos con &lt;b&gt;p95 ≤ 200 ms&lt;/b&gt; durante un lanzamiento." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;shadow=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="460" y="240" width="200" height="110" as="geometry"/></mxCell><mxCell id="c14" value="Confirmar la compra en &lt;b&gt;≤ 2 s (p95)&lt;/b&gt; con 10.000 usuarios concurrentes." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;shadow=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="460" y="365" width="200" height="110" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;🟢 Disponibilidad&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="680" y="165" width="200" height="50" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;" edge="1" parent="1" source="c1" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;99,99 %&lt;/b&gt; de disponibilidad del flujo de compra (≈ 52 min de caída al año)." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;shadow=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="680" y="240" width="200" height="110" as="geometry"/></mxCell><mxCell id="c18" value="Si cae el servicio de Pagos, la orden queda &lt;b&gt;pendiente&lt;/b&gt; y se reintenta: no se pierde ni se duplica." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;shadow=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="680" y="365" width="200" height="110" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;🛠 Mantenibilidad&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="900" y="165" width="200" height="50" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;" edge="1" parent="1" source="c1" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="Cambiar la pasarela (Stripe → PayU) modificando &lt;b&gt;solo un adaptador&lt;/b&gt;." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;shadow=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="900" y="240" width="200" height="110" as="geometry"/></mxCell><mxCell id="c22" value="Cada servicio se despliega de forma independiente en &lt;b&gt;&amp;lt; 15 min&lt;/b&gt; mediante CI/CD." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;shadow=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="900" y="365" width="200" height="110" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;🙂 Usabilidad&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1120" y="165" width="200" height="50" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;" edge="1" parent="1" source="c1" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="Comprar una entrada en &lt;b&gt;≤ 3 pasos&lt;/b&gt; y menos de 90 s." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;shadow=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1120" y="240" width="200" height="110" as="geometry"/></mxCell><mxCell id="c26" value="Feedback visible en cada acción: &lt;i&gt;“Reservando tu entrada…”&lt;/i&gt;." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;shadow=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1120" y="365" width="200" height="110" as="geometry"/></mxCell><mxCell id="c27" value="Carga masiva de eventos por &lt;b&gt;CSV/plantilla&lt;/b&gt; para promotores frecuentes." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;shadow=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1120" y="490" width="200" height="110" as="geometry"/></mxCell><mxCell id="c28" value="Cada nota adhesiva es un NFR medible; el color indica el atributo de calidad con el que se relaciona." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontStyle=2;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="620" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c29" value="01 · Lluvia de ideas de NFR de EventFlow por atributo de calidad" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1340" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>