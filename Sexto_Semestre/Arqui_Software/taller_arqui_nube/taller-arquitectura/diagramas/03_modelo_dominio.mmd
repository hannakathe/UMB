classDiagram
    direction LR
    class Usuario {
      +UUID id
      +String nombre
      +String email
      +Rol rol
      +registrarse()
      +iniciarSesion()
    }
    class Evento {
      +UUID id
      +String nombre
      +DateTime fecha
      +int aforo
      +consultarDisponibilidad()
    }
    class Entrada {
      +UUID id
      +String asiento
      +Estado estado
      +String qrFirmado
      +reservar()
    }
    class Orden {
      +UUID id
      +Decimal total
      +Estado estado
      +confirmar()
    }
    class Pago {
      +UUID id
      +Decimal monto
      +String tokenPasarela
      +autorizar()
    }
    Usuario "1" -- "0..*" Evento : organiza
    Usuario "1" -- "0..*" Orden : realiza
    Evento "1" -- "1..*" Entrada : emite
    Orden "1" -- "1..*" Entrada : contiene
    Orden "1" -- "0..*" Pago : se paga con
    note for Evento "Dominio Core: Evento, Entrada, Orden (inventario y pedidos)"
    note for Usuario "Subdominio genérico (Login)"
