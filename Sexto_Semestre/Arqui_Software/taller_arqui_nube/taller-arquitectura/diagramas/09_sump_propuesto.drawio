aker + timeout 2 s&lt;/b&gt; (Resilience4j) para consultas puntuales de estado de pago; fallback: “Pago en verificación”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7600;fontSize=12;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="390" y="100" width="440" height="90" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Caché Redis&lt;/b&gt;&lt;br&gt;catálogo de asignaturas y cupos (TTL corto)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f8cecc;strokeColor=#cc0000;fontSize=11;fillColor=#fde9e9;" vertex="1" parent="1"><mxGeometry x="370" y="400" width="210" height="110" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Oracle&lt;/b&gt;&lt;br&gt;inscripciones + tabla &lt;b&gt;OUTBOX&lt;/b&gt;&lt;br&gt;(misma transacción ACID)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="400" width="230" height="130" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Relay Outbox / CDC&lt;/b&gt;&lt;br&gt;(p. ej. Debezium)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="900" y="430" width="180" height="70" as="geometry"/></mxCell><mxCell id="c10" value="📨 &lt;b&gt;Cola de mensajería&lt;/b&gt;&lt;br&gt;RabbitMQ / Amazon SQS&lt;br&gt;durable · reintentos · DLQ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="900" y="175" width="200" height="110" as="geometry"/></mxCell><mxCell id="c11" value="☁ AWS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=3;fillColor=#fffaf3;" vertex="1" parent="1"><mxGeometry x="1150" y="60" width=