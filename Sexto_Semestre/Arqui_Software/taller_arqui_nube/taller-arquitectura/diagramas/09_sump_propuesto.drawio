try relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c16" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="✔ &lt;b&gt;Gana:&lt;/b&gt; Disponibilidad y Rendimiento — la inscripción ya no espera a AWS; un fallo de la VPN no bloquea hilos.&lt;br&gt;✔ &lt;b&gt;Gana:&lt;/b&gt; Modificabilidad — la nueva pasarela es un adaptador más detrás del puerto.&lt;br&gt;✖ &lt;b&gt;Se sacrifica:&lt;/b&gt; consistencia inmediata (estado “Pago en verificación” durante segundos → consistencia eventual) y simplicidad operativa (cola, relay y caché que monitorear)." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7600;fontSize=12;shadow=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="740" width="1130" height="105" as="geometry"/></mxCell><mxCell id="c35" value="09 · Arquitectura PROPUESTA del SUMP: asíncrona, con outbox, caché, anticorrupción y circuit breaker" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1660" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>