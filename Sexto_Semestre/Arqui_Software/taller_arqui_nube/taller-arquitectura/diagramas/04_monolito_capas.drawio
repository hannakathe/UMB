" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=8;arcSize=4;" vertex="1" parent="1"><mxGeometry x="60" y="435" width="940" height="120" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Capa de Acceso a Datos (DAL)&lt;/b&gt;&lt;br&gt;El “Cartero”: habla con la BD" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="445" width="230" height="100" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;UserDAO&lt;/b&gt;&lt;br&gt;CRUD Usuarios" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="310" y="455" width="160" height="80" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;EventDAO&lt;/b&gt;&lt;br&gt;CRUD Eventos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="482" y="455" width="160" height="80" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;OrderDAO&lt;/b&gt;&lt;br&gt;CRUD Órdenes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="654" y="455" width="160" height="80" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;PaymentDAO&lt;/b&gt;&lt;br&gt;CRUD Pagos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="826" y="455" width="160" height="80" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Base de Datos única (SQL)&lt;/b&gt;&lt;br&gt;Users · Events · Orders · Payments" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="600" width="260" height="120" as="geometry"/></mxCell><mxCell id="c21" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="llama" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="usa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="✔ &lt;b&gt;Beneficio&lt;/b&gt;&lt;br&gt;Separar la lógica de negocio de la presentación &lt;b&gt;facilita la reutilización del código&lt;/b&gt;: la misma OrderService puede servir a la web, a una app móvil o a una API." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7600;fontSize=12;shadow=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1060" y="115" width="320" height="150" as="geometry"/></mxCell><mxCell id="c26" value="⚠ &lt;b&gt;Problema (NFR de 10.000 usuarios)&lt;/b&gt;&lt;br&gt;En un pico de venta OrderService consume el 99 % de la CPU y &lt;b&gt;todo&lt;/b&gt; el monolito se vuelve lento: login, lista de eventos… No se puede escalar solo OrderService: hay que replicar la aplicación entera (y la BD única sigue siendo un cuello de botella).&lt;br&gt;&lt;b&gt;Atributo afectado: Escalabilidad.&lt;/b&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#cc0000;fontSize=12;shadow=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1060" y="290" width="320" height="250" as="geometry"/></mxCell><mxCell id="c27" value="04 · EventFlow como Monolito en Capas — “El Bloque Unido”" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1400" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>