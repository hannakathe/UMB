<mxfile host="generar_diagramas.py"><diagram name="03 · Modelo de dominio de EventFlow (DDD): Dominio Core vs. subdominios genéricos" id="03_modelo_dominio"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="740" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Subdominio genérico&lt;br&gt;(Login / Usuarios)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=3;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="270" height="330" as="geometry"/></mxCell><mxCell id="c2" value="⭐ DOMINIO CORE — Gestión de Inventario de Entradas y Pedidos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7600;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=3;fillColor=#f3faf0;" vertex="1" parent="1"><mxGeometry x="330" y="60" width="680" height="520" as="geometry"/></mxCell><mxCell id="c3" value="Subdominio de soporte&lt;br&gt;(Pagos → pasarela externa)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=3;fillColor=#fffaf3;" vertex="1" parent="1"><mxGeometry x="1050" y="280" width="290" height="300" as="geometry"/></mxCell><mxCell id="c4" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Usuario&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;id: UUID&lt;br&gt;nombre: String&lt;br&gt;email: String&lt;br&gt;rol: {Comprador, Organizador, Admin}&lt;hr size=&quot;1&quot;&gt;registrarse()&lt;br&gt;iniciarSesion()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="130" widt