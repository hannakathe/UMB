=none;strokeWidth=1.5;exitX=1;exitY=0.75;entryX=0;entryY=0.8;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontStyle=1;" vertex="1" connectable="0" parent="c21"><mxGeometry x="-0.75" relative="1" as="geometry"><mxPoint y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="c23" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontStyle=1;" vertex="1" connectable="0" parent="c21"><mxGeometry x="0.75" relative="1" as="geometry"><mxPoint y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="c24" value="El &lt;b&gt;Dominio Core&lt;/b&gt; es lo que diferencia a EventFlow en el mercado: vender sin sobreventa ni pérdidas el inventario limitado de entradas durante picos de demanda. Login/Usuarios es un problema resuelto (genérico) que puede comprarse o delegarse (OAuth, Auth0, Cognito); Pagos se delega a una pasarela." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="600" width="1320" height="70" as="geometry"/></mxCell><mxCell id="c25" value="03 · Modelo de dominio de EventFlow (DDD): Dominio Core vs. subdominios genéricos" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1360" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>