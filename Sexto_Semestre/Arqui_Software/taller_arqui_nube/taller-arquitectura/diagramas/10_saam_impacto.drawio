<mxfile host="generar_diagramas.py"><diagram name="10 · Análisis SAAM de impacto: componentes afectados por cada escenario de cambio" id="10_saam_impacto"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="740" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Escenario 1 · EventFlow: cambiar el Bus de Eventos de Kafka a RabbitMQ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=3;fillColor=#fcfcfc;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="720" height="560" as="geometry"/></mxCell><mxCell id="c2" value="API Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7600;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="260" y="110" width="240" height="45" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Servicio-&lt;br&gt;Usuarios&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7600;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="125" height="80" as="geometry"/></mxCell><mxCell id="c4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#999999;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c5" value="&lt;b&gt;Servicio-&lt;br&gt;Eventos&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7600;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="177" y="200" width="125" height="80" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#999999;" edge="1" parent="1" source="c2" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="&lt;b&gt;Servicio-&lt;br&gt;Pedidos&lt;br&gt;(suscriptor)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#cc0000;fontSize=12;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="314" y="200" width="125" height="80" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#999999;" edge="1" parent="1" source="c2" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="&lt;b&gt;Servicio-&lt;br&gt;Entradas&lt;br&gt;(suscriptor)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#cc0000;fontSize=12;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="451" y="200" width="125" height="80" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#999999;" edge="1" parent="1" source="c2" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;Servicio-&lt;br&gt;Pagos&lt;br&gt;(publicador)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#cc0000;fontSize=12;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="588" y="200" width="125" height="80" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#999999;" edge="1" parent="1" source="c2" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="&lt;b&gt;Bus de eventos: Kafka → RabbitMQ&lt;/b&gt; (se reemplaza)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#cc0000;fontSize=12;arcSize=8;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="680" height="55" as="geometry"/></mxCell><mxCell id="c14" value="" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;strokeColor=#cc0000;strokeWidth=2;dashed=1;" edge="1" parent="1" source="c7" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;strokeColor=#cc0000;strokeWidth=2;dashed=1;" edge="1" parent="1" source="c9" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;strokeColor=#cc0000;strokeWidth=2;dashed=1;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;Conteo:&lt;/b&gt; 3 de 5 servicios (solo su cliente/adaptador de mensajería) + la infraestructura del bus. Usuarios, Eventos y el API Gateway &lt;b&gt;ni se enteran&lt;/b&gt;.&lt;br&gt;Si los servicios usan un puerto común &lt;i&gt;PublicadorEventos/SuscriptorEventos&lt;/i&gt;, el cambio se reduce a 1 librería compartida + configuración.&lt;br&gt;&lt;b&gt;Veredicto: ALTA modificabilidad ✅&lt;/b&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7600;fontSize=12;shadow=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="680" height="180" as="geometry"/></mxCell><mxCell id="c18" value="Escenario 2 · SUMP: nueva pasarela gubernamental de recaudos en 30 días" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=3;fillColor=#fcfcfc;" vertex="1" parent="1"><mxGeometry x="780" y="60" width="720" height="560" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Interfaz web (pantallas de pago JSP)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#cc0000;fontSize=12;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="800" y="115" width="215" height="95" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Monolito Java (controlador PaymentGateway, lógica de matrícula)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#cc0000;fontSize=12;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1030" y="115" width="215" height="95" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Microservicio de Pagos Node.js (integración con la pasarela)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#cc0000;fontSize=12;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1260" y="115" width="215" height="95" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;BD Oracle (estados de pago, referencias, conciliación)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#cc0000;fontSize=12;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="800" y="235" width="215" height="95" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;VPN / red (reglas, certificados del gobierno)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1030" y="235" width="215" height="95" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Reportes de Contabilidad (conciliación)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1260" y="235" width="215" height="95" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Conteo:&lt;/b&gt; 4 componentes afectados con seguridad (UI, Monolito, Microservicio, Oracle) + 2 probables (VPN, reportes) = 4–6 de 6. No existe una interfaz que aísle la pasarela: el monolito conoce los detalles del microservicio y la BD guarda datos propios del proveedor, así que el cambio &lt;b&gt;se propaga&lt;/b&gt;.&lt;br&gt;&lt;b&gt;Veredicto: BAJA modificabilidad ❌&lt;/b&gt; — alto riesgo de incumplir el plazo legal de 30 días." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#cc0000;fontSize=12;shadow=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="800" y="365" width="680" height="235" as="geometry"/></mxCell><mxCell id="c26" value="Leyenda: 🟥 afectado · 🟧 probablemente afectado · 🟩 no afectado" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;align=center;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="1480" height="30" as="geometry"/></mxCell><mxCell id="c27" value="10 · Análisis SAAM de impacto: componentes afectados por cada escenario de cambio" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1520" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>