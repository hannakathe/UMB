# MemoryCaptures
[Mm]emory[Cc]aptures/

# Asset meta data (except scripts & important assets)
# Keep all .meta files for proper asset tracking
# !/Assets/**/*.meta

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D Generated File On Crash Reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Backup files
*.bak
*.backup
*~

# OS generated
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Rider / Visual Studio / VS Code
.idea/
.vs/
.vscode/
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs

# Packages lock (regenerado automáticamente por Unity)
Packages/packages-lock.json

# Claude Code (configuración local del asistente)
.claude/
